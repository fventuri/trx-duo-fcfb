#!/usr/bin/env python3
# dual-decoder -- run a WSJT-X-style decoder on both channels of a stereo WAV.
#
# fcfbfarm writes an adc=3 (diversity) channel as ONE stereo WAV, left = ADC A,
# right = ADC B, sample-for-sample time-locked.  A decoder like jt9/wsprd only
# reads mono, so this wrapper splits the stereo file into two temporary mono WAVs,
# runs the given command on each IN SEQUENCE (so one dual channel still uses a
# single fcfbfarm worker slot -- the num_workers/-workers constraint is honoured),
# passes each decoder's stdout straight through (fcfbfarm parses it), then removes
# the temporary files.
#
# Usage, as an fcfbfarm [decoder] cmd (the farm substitutes {wav}):
#     cmd = dual-decoder jt9 --ft8 {wav}
#     cmd = dual-decoder wsprd -f {fmhz} {wav}
#
# The wav argument is whichever argument is an existing .wav file.  If the file is
# not stereo, the command is run once unchanged (safe on a mono channel).
#
# 16-bit PCM only (what fcfbfarm writes).  WAV is little-endian; array('h') is
# native, which is little-endian on the x86 host this runs on.
import os
import sys
import wave
import array
import subprocess


def find_wav(argv):
    wav_idx = None
    for i, a in enumerate(argv):
        if a.lower().endswith(".wav") and os.path.isfile(a):
            wav_idx = i  # last matching wins
    return wav_idx


def write_mono(path, samples, framerate, sampwidth):
    w = wave.open(path, "wb")
    try:
        w.setnchannels(1)
        w.setsampwidth(sampwidth)
        w.setframerate(framerate)
        w.writeframes(samples.tobytes())
    finally:
        w.close()


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.stderr.write("dual-decoder: no command given\n")
        return 2

    wav_idx = find_wav(argv)
    if wav_idx is None:
        sys.stderr.write("dual-decoder: no .wav argument found in: %s\n" % " ".join(argv))
        return 2
    wavpath = argv[wav_idx]

    r = wave.open(wavpath, "rb")
    nch = r.getnchannels()
    sampwidth = r.getsampwidth()
    framerate = r.getframerate()
    nframes = r.getnframes()
    data = r.readframes(nframes)
    r.close()

    # Not stereo: run the command once, unchanged (mono passthrough).
    if nch != 2:
        return subprocess.run(argv).returncode

    if sampwidth != 2:
        sys.stderr.write("dual-decoder: only 16-bit PCM supported (got %d bytes/sample)\n" % sampwidth)
        return 2

    interleaved = array.array("h")
    interleaved.frombytes(data)
    left = interleaved[0::2]   # ADC A
    right = interleaved[1::2]  # ADC B

    outdir = os.path.dirname(wavpath) or "."
    base = os.path.basename(wavpath)  # e.g. 260927_1830.wav
    rc = 0
    tmpfiles = []
    try:
        # A-/B- PREFIX, applied for every mode (mode-independent).  Prefixing keeps
        # the numeric "..._HHMM(SS).wav" tail intact, so jt9 and wsprd still parse
        # the timestamp from the filename by offset from ".wav".  A suffix before
        # ".wav" would shift wsprd's 4-char HHMM field onto non-digits and silently
        # drop every WSPR decode; the prefix avoids that.
        for ant, samples in (("A", left), ("B", right)):
            mono = os.path.join(outdir, "%s-%s" % (ant, base))
            tmpfiles.append(mono)
            write_mono(mono, samples, framerate, sampwidth)
            cmd = list(argv)
            cmd[wav_idx] = mono
            # Tag which antenna the following decode lines came from: fcfbfarm's
            # parser reads this "#ANT <A|B>" marker and stamps each spot's antenna.
            # Flush first so it lands BEFORE the subprocess's own stdout (which writes
            # straight to fd 1), keeping the marker->lines order correct.
            print("#ANT %s" % ant, flush=True)
            # stdout/stderr inherit this process's -> flow to fcfbfarm, which parses
            # both antennas' decode lines from the combined output.
            res = subprocess.run(cmd)
            if res.returncode != 0:
                rc = res.returncode
    finally:
        for tmp in tmpfiles:
            try:
                os.remove(tmp)
            except OSError:
                pass
    return rc


if __name__ == "__main__":
    sys.exit(main())
